// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── CACHE (somente leitura, espelha as APIs) ──────────────

model CachedPlayer {
  id           String   @id @default(cuid())
  source       String // "kaggle-fc26" | "api-football" | "thesportsdb" | "custom"
  externalId   String
  name         String
  photoUrl     String?
  nationality  String?
  position     String?
  club         String?
  league       String?
  overall      Int?
  potential    Int?
  age          Int?
  externalLink String? // link externo informado manualmente (ex: ogol, transfermarket) para jogadores "custom"
  rawData      Json // payload bruto, para reprocessar sem rechamar a API
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime

  squadPlayers SquadPlayer[]

  @@unique([source, externalId])
  @@index([name])
  @@index([club])
  @@index([league])
}

model CachedClub {
  id         String   @id @default(cuid())
  source     String
  externalId String
  name       String
  league     String?
  country    String?
  logoUrl    String?
  rawData    Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([source, externalId])
}

model CachedNationalTeam {
  id         String   @id @default(cuid())
  source     String
  externalId String
  name       String
  flagUrl    String?
  rawData    Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([source, externalId])
}

// ── DADOS DO USUÁRIO (customizações) ──────────────────────

model Squad {
  id          String   @id @default(cuid())
  name        String // "Coritiba", "Barcelona 2011", "Time dos Sonhos"
  baseClubRef String? // externalId do CachedClub/CachedNationalTeam de origem, se carregado de um clube/seleção real
  logoUrl     String? // escudo do elenco — copiado do clube de origem na criação (se houver) e editável livremente depois; nunca buscado ao vivo
  formation   String   @default("4-3-3")

  // Técnico: dado inteiramente manual, sem fonte externa (nenhum provider cobre técnicos).
  coachName         String?
  coachPhotoUrl     String?
  coachExternalLink String?

  notes String? // observações livres do usuário sobre o elenco — texto solto, sem estrutura

  isFavorite Boolean @default(false)

  // categoryId nulo = "Outros" na UI; não existe uma categoria "Outros" de
  // verdade no banco, então excluir uma Category some sozinha daqui
  // (onDelete: SetNull) sem precisar de nenhuma lógica extra.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags Tag[] @relation("SquadTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players SquadPlayer[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  squads Squad[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  squads Squad[] @relation("SquadTags")
}

model SquadPlayer {
  id             String       @id @default(cuid())
  squadId        String
  squad          Squad        @relation(fields: [squadId], references: [id], onDelete: Cascade)
  cachedPlayerId String
  cachedPlayer   CachedPlayer @relation(fields: [cachedPlayerId], references: [id])
  shirtNumber    Int?
  isCaptain      Boolean      @default(false)
  isStarter      Boolean      @default(true) // false = banco de reservas
  positionSlot   String? // posição na formação, ex: "LW", "CB1"
  order          Int          @default(0)

  @@unique([squadId, cachedPlayerId])
}
