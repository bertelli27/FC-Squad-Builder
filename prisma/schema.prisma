// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── CACHE (somente leitura, espelha as APIs) ──────────────

model CachedPlayer {
  id           String   @id @default(cuid())
  source       String // "kaggle-fc26" | "api-football" | "thesportsdb" | "custom"
  externalId   String
  name         String
  photoUrl     String?
  nationality  String?
  position     String?
  club         String?
  league       String?
  overall      Int?
  potential    Int?
  age          Int? // idade estática legada — preferir dateOfBirth + lib/player-age.ts quando disponível (§4/5, etapa 6)
  externalLink String? // link externo informado manualmente (ex: ogol, transfermarket) para jogadores "custom"

  // ── Etapa 6: cadastro do jogador vira editável independente da origem ──
  // (revisa a garantia antiga do §7 — "cache nunca é editado pelo
  // usuário" — que valia só pra dados de clube/seleção agora). Editar
  // aqui é seguro mesmo pra jogadores reais (kaggle/api-football/
  // thesportsdb): o mesmo CachedPlayer é compartilhado por toda referência
  // a esse jogador (squads, carreira), então a edição reflete em todo
  // lugar de propósito — é a mesma pessoa. `manuallyEdited` avisa o
  // importador do Kaggle (scripts/import-ratings.ts) pra não sobrescrever
  // silenciosamente um cadastro que o usuário já customizou.
  dateOfBirth        DateTime?
  secondaryPositions String[]  @default([])
  manuallyEdited     Boolean   @default(false)

  rawData      Json // payload bruto, para reprocessar sem rechamar a API
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime

  squadPlayers SquadPlayer[]
  careers      PlayerCareer[]
  transfers    Transfer[]

  @@unique([source, externalId])
  @@index([name])
  @@index([club])
  @@index([league])
}

model CachedClub {
  id         String   @id @default(cuid())
  source     String
  externalId String
  name       String
  league     String?
  country    String?
  logoUrl    String?
  rawData    Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([source, externalId])
}

model CachedNationalTeam {
  id         String   @id @default(cuid())
  source     String
  externalId String
  name       String
  flagUrl    String?
  rawData    Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([source, externalId])
}

// ── DADOS DO USUÁRIO (customizações) ──────────────────────

// Representa o CLUBE (ou seleção/time-dos-sonhos) em si — identidade,
// organização (categoria/tags/favorito) e a cor de identidade visual.
// Nunca guarda elenco/técnico/formação diretamente: isso é uma fotografia
// de uma Season específica (§ Season abaixo). Um Squad tem 1+ Season.
model Squad {
  id          String   @id @default(cuid())
  name        String // "Coritiba", "Barcelona 2011", "Time dos Sonhos"
  baseClubRef String? // externalId do CachedClub/CachedNationalTeam de origem, se carregado de um clube/seleção real
  // "club" | "nationalTeam" | null (do zero/desconhecido) — setado uma
  // única vez na criação a partir da aba escolhida (Clube/Seleção/Do
  // zero); não editável depois. Só "nationalTeam" ganha a área de
  // observados no editor (ver SquadPlayer.isWatchlist).
  baseKind    String?
  logoUrl     String? // escudo do elenco — copiado do clube de origem na criação (se houver) e editável livremente depois; nunca buscado ao vivo

  // Cor de identidade visual do clube (hex, ex: "#006B3F") — null = usa o
  // tema verde padrão do app. Pertence ao clube, não à temporada nem à
  // carreira de um jogador (§12.9/§12.11): todas as temporadas do mesmo
  // clube reutilizam essa mesma cor.
  primaryColor String?

  // "brasileiro" (rótulo = ano: "2026") | "europeu" (rótulo = par de anos:
  // "26/27") — como as temporadas desse clube são exibidas. Vale pra todas
  // as temporadas do clube (não é escolhido temporada a temporada: um
  // clube não muda de calendário de uma temporada pra outra na vida real).
  seasonCalendar String @default("brasileiro")

  isFavorite Boolean @default(false)

  // categoryId nulo = "Outros" na UI; não existe uma categoria "Outros" de
  // verdade no banco, então excluir uma Category some sozinha daqui
  // (onDelete: SetNull) sem precisar de nenhuma lógica extra.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags Tag[] @relation("SquadTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons Season[]
}

// Uma fotografia independente do clube num período: elenco, técnico e
// formação próprios. Editar uma Season nunca afeta outra da mesma Squad —
// é exatamente essa independência que permite duplicar 2026 → 2027 e depois
// divergir livremente (§ etapa 1, seção 4/6).
model Season {
  id      String @id @default(cuid())
  squadId String
  squad   Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)

  // Ano-base da temporada, sempre um inteiro (mesmo no calendário europeu,
  // onde representa o primeiro ano do par: 2026 → rótulo "26/27"). Usado
  // tanto pra ordenar cronologicamente quanto pra montar o rótulo exibido
  // (Squad.seasonCalendar decide o formato — ver lib/season.ts).
  startYear Int

  formation String @default("4-3-3")

  // Técnico (§ nova etapa): agora uma entidade compartilhada (Coach) — o
  // mesmo técnico pode ser reaproveitado em várias temporadas, e editá-lo
  // no Gerenciamento reflete em todas elas (referência, não cópia — mesmo
  // princípio de CareerStint.seasonId: identidade compartilhada, nunca
  // sincronizada por texto). Antes de dezembro/2026 eram 3 campos de texto
  // soltos e independentes por temporada; a migration desta etapa criou um
  // Coach próprio pra cada temporada que já tinha técnico preenchido, sem
  // nunca mesclar nomes iguais de temporadas diferentes automaticamente
  // (podem ser pessoas diferentes). SetNull: apagar um técnico no
  // Gerenciamento só limpa esta referência, nunca a temporada em si.
  coachId String?
  coach   Coach?  @relation(fields: [coachId], references: [id], onDelete: SetNull)

  notes String? // "Resumo da temporada" — texto livre sobre esta temporada, sem estrutura. Deliberadamente NUNCA copiado ao duplicar uma temporada (seasonService.createSeason) — é específico dela, não faz parte da "base" reaproveitável.

  // Desempenho da temporada (§ etapa 2). "Partidas" não é uma coluna
  // própria — é sempre wins+draws+losses (ver lib/season.ts), o que torna
  // a inconsistência "partidas ≠ vitórias+empates+derrotas" estruturalmente
  // impossível em vez de precisar validar isso toda vez que os 3 campos
  // são editados.
  wins   Int @default(0)
  draws  Int @default(0)
  losses Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players   SquadPlayer[]
  titles    SeasonTitle[]
  transfers Transfer[]
  // Passagens de carreira (§5 etapa 4) que referenciam esta temporada como
  // "reaproveitar elenco existente" — ver comentário em CareerStint. Uma
  // temporada não sabe nem precisa saber quais carreiras a referenciam
  // além disso (a relação existe só pra permitir onDelete: SetNull).
  careerStints CareerStint[]
  // Idem, pra CompetitionChampion (etapa 9, Modo B) — vínculo opcional de
  // "esta temporada foi campeã de tal edição", sem a Season precisar saber
  // nada além de permitir onDelete: SetNull.
  championEntries CompetitionChampion[]
  // Minikits (etapa 9 parte 3) — uniformes pertencem à TEMPORADA, não ao
  // clube: Coritiba 2019 e Coritiba 2026 têm conjuntos de kits totalmente
  // independentes. Ver SeasonKit abaixo.
  kits SeasonKit[]
  // Competições disputadas (etapa 9 parte 4, §1) — lista própria da
  // temporada, nunca do clube. Ver SeasonCompetition abaixo.
  competitions SeasonCompetition[]

  @@unique([squadId, startYear])
  @@index([squadId])
  @@index([coachId])
}

// Etapa 9 parte 4 (§1) — "competições disputadas nesta temporada": ao
// adicionar uma Competition aqui, ela passa a aparecer automaticamente nas
// estatísticas de todo jogador do elenco desta temporada (ver
// PlayerStatsSection), sem precisar cadastrar jogador por jogador. Uma
// linha aqui é só uma "declaração de participação" — NÃO cria
// PlayerCompetitionStats nenhuma sozinha (essas só nascem quando um valor
// de fato é digitado pra um jogador, ver player-stats.service.ts), então
// remover uma competição da temporada nunca apaga estatística já
// preenchida (o jogador que já tinha dados continua com eles, mesmo que a
// competição saia dessa lista). Nunca copiada ao duplicar temporada — cada
// temporada declara as suas do zero, mesmo espírito de SeasonKit.
model SeasonCompetition {
  id            String      @id @default(cuid())
  seasonId      String
  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([seasonId, competitionId])
  @@index([seasonId])
  @@index([competitionId])
}

// Um uniforme (minikit, estilo EA FC/FIFA) de uma temporada específica —
// no máximo 5 por temporada (home/away/third/fourth/goalkeeper, ver
// lib/kits.ts), nenhum criado automaticamente: o usuário cadastra só os
// tipos que quiser, na ordem/combinação que quiser. `type` guarda um dos
// valores de KIT_TYPES (lib/kits.ts) — não é um enum do banco pra manter
// o mesmo padrão já usado em Competition.kind/scope (string livre validada
// na camada de serviço/API, não no schema). `imageUrl` reaproveita a MESMA
// infraestrutura de upload (Vercel Blob via /api/upload) já usada por
// CachedPlayer.photoUrl/Squad.logoUrl/Competition.logoUrl — nenhum storage
// novo. onDelete: Cascade porque um kit não tem sentido sem a temporada
// dona dele (mesmo princípio de SquadPlayer/SeasonTitle/Transfer).
model SeasonKit {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  type     String
  imageUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, type])
  @@index([seasonId])
}

// Um técnico (§ nova etapa) — existe uma vez só, reaproveitável por
// qualquer temporada de qualquer clube (Season.coachId), mesmo padrão de
// Competition acima. Dado inteiramente manual, sem fonte externa (nenhum
// provider cobre técnicos). Nome deliberadamente NÃO único: duas pessoas
// reais podem ter o mesmo nome, e tratar isso como "a mesma" seria
// misatribuir histórico — ver comentário da migration desta etapa.
model Coach {
  id           String   @id @default(cuid())
  name         String
  photoUrl     String?
  externalLink String?
  createdAt    DateTime @default(now())

  seasons Season[]
}

// Uma competição/torneio (Brasileirão, Paranaense, Copa do Brasil...) —
// existe uma vez só, reutilizada por SeasonTitle de qualquer temporada de
// qualquer clube, para que o troféu (imagem informada pelo usuário, nunca
// inventada) só precise ser cadastrado uma vez e já valha pra sempre.
model Competition {
  id   String @id @default(cuid())
  name String @unique
  // Identidade visual da competição (§ nova etapa) — usada nas telas de
  // ESTATÍSTICA (jogos/gols/assistências por competição). Distinto de
  // trophyImageUrl (a taça física conquistada, usada nas telas de TÍTULO):
  // são dois conceitos diferentes que só coincidem por acaso, nunca devem
  // ser preenchidos automaticamente um a partir do outro.
  logoUrl        String?
  trophyImageUrl String?

  // Etapa 9 parte 2: classificação da competição em 4 níveis — nenhum
  // obrigatório (competições já cadastradas ficam com tudo null, e
  // continuam funcionando exatamente como antes).
  // TIPO — "club" | "nationalTeam" | null (não classificado) — decide se
  // um CompetitionChampion desta competição é um clube ou uma seleção.
  kind String?
  // ABRANGÊNCIA — "world" | "continental" | "national" | null. Campo
  // renomeado nesta etapa (era "category", só "international"|"national"
  // — nenhuma competição em produção tinha isso preenchido ainda, então
  // não houve valor antigo pra migrar). Junto com `kind` decide o que
  // `organizer`/`country` abaixo significam.
  scope String?
  // ORGANIZAÇÃO — depende de `scope`: "FIFA" fixo quando scope=world;
  // uma das 6 confederações (UEFA/CONMEBOL/CONCACAF/CAF/AFC/OFC) quando
  // scope=continental; a federação nacional livre (ex: "CBF") quando
  // scope=national. Continua sendo texto livre no banco (a validação de
  // "só essas 6 confederações" é responsabilidade do formulário/serviço,
  // não uma constraint de banco) — não é uma entidade própria, sem foto/
  // página, só uma categoria de agrupamento na listagem.
  organizer String?
  // PAÍS — enName de lib/countries.ts (ex: "Brazil") — só relevante
  // quando scope === "national".
  country     String?
  description String? // descrição/explicação livre da competição
  createdAt   DateTime @default(now())

  titles       SeasonTitle[]
  playerStats  PlayerCompetitionStats[]
  careerTitles     CareerTitle[]
  careerStintStats CareerStintCompetitionStats[]
  champions        CompetitionChampion[]
  seasonCompetitions SeasonCompetition[]
}

// Histórico de campeões de UMA edição/ano de uma competição (etapa 9) —
// INDEPENDENTE do sistema de títulos (SeasonTitle/CareerTitle): registra
// "quem venceu aquela edição", nunca atribui automaticamente um título ao
// clube/seleção no perfil dele (os dois sistemas não se tocam).
//
// Dois modos, nunca ao mesmo tempo:
//   Modo A (standalone): campeão histórico sem elenco cadastrado no
//     sistema — comum pra edições antigas (Copa 1930, etc). seasonId fica
//     null; standaloneName/standaloneLogoUrl/standaloneCountry são
//     digitados na hora.
//   Modo B (vinculado): referencia uma Season já cadastrada (mesmo
//     princípio de "referência seg a, nunca sincronização" de
//     CareerStint.seasonId — onDelete SetNull, o registro histórico nunca
//     desaparece se a Season for apagada depois). standaloneName/
//     standaloneLogoUrl são copiados do Squad no momento do vínculo (nunca
//     ficam vazios, mesmo no Modo B) — funcionam como snapshot de exibição
//     E como fallback caso a Season vinculada seja apagada depois.
model CompetitionChampion {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  year          Int

  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  standaloneName    String
  standaloneLogoUrl String?
  // enName de lib/countries.ts, pra bandeira — Squad não guarda país
  // próprio (só Season.baseKind === "nationalTeam" tem nome de país como
  // nome do elenco), então vínculos com Season de clube ficam sem bandeira
  // de propósito; registros standalone sempre podem informar um país.
  standaloneCountry String?

  createdAt DateTime @default(now())

  @@unique([competitionId, year])
  @@index([competitionId])
  @@index([seasonId])
}

// Um título conquistado NUMA temporada específica — nunca "vaza" pra outra
// (§1: "os títulos de uma temporada não podem aparecer automaticamente em
// outra"). O palmarés geral do clube (§3) é sempre calculado agregando
// esses registros nas temporadas do clube, nunca um total guardado à parte
// (evita o total "descolar" da soma real dos títulos por temporada).
model SeasonTitle {
  id            String      @id @default(cuid())
  seasonId      String
  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([seasonId, competitionId])
  @@index([seasonId])
}

// Uma entrada (contratação) ou saída (venda) de jogador na temporada
// (§4) — dado inteiramente manual/textual (nome do jogador e do clube
// contraparte), sem vínculo com CachedPlayer/SquadPlayer: uma
// transferência registra HISTÓRICO de mercado, não necessariamente alguém
// que chegou a entrar no elenco da temporada (ex: uma venda de alguém que
// já tinha saído do elenco antes dessa funcionalidade existir).
// Etapa 7: uma transferência passa a ser uma movimentação real do jogador
// entre CachedPlayer (§24, entidade central) e o elenco da temporada — não
// mais só um registro de texto livre. `cachedPlayerId` é opcional pra
// preservar as linhas antigas (criadas antes desta etapa, só com
// playerName/counterpartClub em texto livre) sem precisar de backfill;
// todo fluxo NOVO (transferir/contratar) sempre preenche esse campo.
// `playerName` continua sendo salvo mesmo quando cachedPlayerId existe —
// é um retrato do nome no momento da transferência (o mesmo princípio já
// usado em CareerStint pra clube/foto: cópia, não sincronização ao vivo),
// então a lista de transferências nunca precisa fazer join pra exibir.
model Transfer {
  id              String   @id @default(cuid())
  seasonId        String
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  type            String // "in" | "out"
  playerName      String
  counterpartClub String? // clube de origem (in) ou de destino (out)
  value           Float? // valor da transferência; null = não informado
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  cachedPlayerId String?
  cachedPlayer   CachedPlayer? @relation(fields: [cachedPlayerId], references: [id])
  dealType       String        @default("permanent") // "permanent" | "loan" — livre/gratuita é só um "permanent" com value = null (§18)

  // Espelho opcional em CareerTransfer (ver comentário lá) — 1:1, criado
  // automaticamente quando o jogador tem carreira vinculada ao mesmo
  // CachedPlayer.
  careerMirror CareerTransfer?

  @@index([seasonId])
  @@index([cachedPlayerId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  squads Squad[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  squads Squad[] @relation("SquadTags")
}

model SquadPlayer {
  id             String       @id @default(cuid())
  // Escalação de UMA temporada específica — não do clube diretamente
  // (§ Season acima). O nome do model ficou de um desenho anterior à
  // existência de temporadas; renomeá-lo exigiria uma migração de tabela
  // arriscada sem ganho real, então manteve-se "SquadPlayer" mesmo
  // pendurado em Season agora.
  seasonId       String
  season         Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  cachedPlayerId String
  cachedPlayer   CachedPlayer @relation(fields: [cachedPlayerId], references: [id])
  shirtNumber    Int?
  isCaptain      Boolean      @default(false)
  isStarter      Boolean      @default(true) // false = banco de reservas
  // jogador observado (fora dos titulares/reserva "oficiais") — só usado
  // quando Squad.baseKind === "nationalTeam"; nunca true por qualquer
  // fluxo de elenco de clube.
  isWatchlist    Boolean      @default(false)
  // além dos 26 convocados (titular+banco) — só usado quando
  // Squad.baseKind === "nationalTeam". Mutuamente exclusivo com
  // isWatchlist na prática: cada jogador vive em exatamente um balde
  // (titular/banco, extra, ou observado).
  isExtra        Boolean      @default(false)
  positionSlot   String? // posição na formação, ex: "LW", "CB1"
  order          Int          @default(0)
  // Etapa 9 parte 4 (§4) — ajuste fino de posição dentro/ao redor do slot
  // da formação: um deslocamento em pontos percentuais do campo (mesma
  // escala de FormationSlot.x/y em lib/formations.ts), somado por cima da
  // coordenada padrão do slot na hora de desenhar. null = usa a posição
  // padrão do slot exatamente (comportamento de sempre, nenhuma mudança
  // visual pra quem nunca arrastou). positionSlot continua sendo a fonte
  // de verdade pra TUDO que já depende da identidade do slot (titular/
  // reserva, troca ao arrastar entre slots, contagem de 26 convocados
  // etc.) — isso só afeta onde dentro da vizinhança do slot o chip é
  // desenhado. Resetado (null) sempre que o jogador entra num slot novo
  // (troca de posição, saiu do banco/observados/extras, ou a formação
  // mudou) — só é preenchido pelo ajuste fino "soltar de volta perto do
  // mesmo slot" no campo tático.
  xOffset Float?
  yOffset Float?

  competitionStats PlayerCompetitionStats[]

  @@unique([seasonId, cachedPlayerId])
}

// Estatísticas de UM jogador em UMA competição, dentro de UMA temporada
// (§1 etapa 3) — pendurada em SquadPlayer (que já escopa jogador+temporada
// sozinho) em vez de precisar repetir seasonId/cachedPlayerId aqui. O
// "total" (§2) nunca é uma coluna própria: é sempre a soma dessas linhas
// pelo mesmo squadPlayerId, calculada sob demanda (mesmo padrão de
// Season.wins/draws/losses → partidas). Duplicar uma temporada cria NOVAS
// linhas de SquadPlayer (mesmo cachedPlayerId, id novo) e nunca copia
// PlayerCompetitionStats — é assim que "as estatísticas de 2026 não podem
// virar estatísticas de 2027" (§4) acontece de graça, sem lógica extra.
model PlayerCompetitionStats {
  id            String      @id @default(cuid())
  squadPlayerId String
  squadPlayer   SquadPlayer @relation(fields: [squadPlayerId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  appearances Int @default(0)
  goals       Int @default(0)
  assists     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([squadPlayerId, competitionId])
  @@index([squadPlayerId])
  @@index([competitionId])
}

// ── CARREIRAS DE JOGADOR (§ etapa 4) ───────────────────────
//
// Segundo grande contexto do app, ao lado de Clubes — a trajetória
// completa de UMA pessoa através de vários clubes, independente de
// qualquer Squad específico. Deliberadamente NÃO reaproveita SquadPlayer
// (que representa "um jogador NUM elenco NUMA temporada de UM clube", o
// oposto do que uma carreira precisa modelar) nem duplica elenco algum —
// ver comentário em CareerStint.

// A pessoa cuja carreira está sendo registrada. `cachedPlayerId` referencia
// o mesmo CachedPlayer já usado nos elencos (§14/§24: "se já existe um
// jogador no banco, use-o em vez de criar outro registro idêntico").
//
// Etapa 6 (§16/§24): `cachedPlayerId` agora é sempre preenchido por
// createCareer — quando não há playerRef (busca), um CachedPlayer
// "custom" é criado pra carreira, igual createCustomPlayer já faz pros
// elencos. Isso garante um cadastro central único por jogador: "Editar
// jogador" na carreira edita esse CachedPlayer diretamente (via
// PATCH /api/players/[id]), e getCareerById/listCareers passam a priorizar
// os campos ao vivo do CachedPlayer sobre `name`/`photoUrl` abaixo, que
// ficam como cópia congelada do valor na criação (mantidos só por
// compatibilidade com o dado antigo de carreiras pré-etapa-6 e como
// fallback defensivo caso cachedPlayerId nunca tenha sido setado).
model PlayerCareer {
  id             String        @id @default(cuid())
  name           String
  photoUrl       String?
  cachedPlayerId String?
  cachedPlayer   CachedPlayer? @relation(fields: [cachedPlayerId], references: [id])

  // "Resumo da carreira" (§9) — geral, diferente do resumo de cada
  // temporada (§8, ver CareerStint.summary).
  summary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stints    CareerStint[]
  transfers CareerTransfer[]
}

// Uma passagem por um clube numa temporada específica (§4) — o
// equivalente, na carreira, ao que Season é pro módulo de clubes.
//
// `seasonId` é uma referência OPCIONAL e segura a uma Season já cadastrada
// no módulo de clubes (§5/§6: "reaproveitar elencos existentes... não
// crie uma cópia inteira do elenco"). Ela existe só pra: (a) evitar
// re-digitar nome/escudo/calendário de um clube que já está cadastrado, e
// (b) um link de volta pra ver aquele elenco completo. NÃO sincroniza
// estatísticas com PlayerCompetitionStats daquela Season — os campos
// abaixo (appearances/goals/assists/titles/summary) são sempre inteiramente
// próprios da carreira, preenchidos manualmente. Essa é a "referência
// segura, não sincronização bidirecional" pedida, em vez de algo mais
// arriscado.
// clubName/clubLogoUrl/startYear/calendar são copiados da Season no
// momento da criação (quando vinculado) e continuam existindo mesmo que a
// Season vinculada seja apagada depois (onDelete: SetNull) — o stint nunca
// fica "quebrado" por causa de uma mudança no módulo de clubes.
model CareerStint {
  id       String       @id @default(cuid())
  careerId String
  career   PlayerCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  // "club" | "nationalTeam" (§1/§11 etapa 5) — separa a aba SELEÇÃO da aba
  // CLUBES sem precisar de um model paralelo: um CareerStint já modela
  // "uma passagem", seja por clube ou por seleção; só o que se pode
  // registrar dentro dela difere (ver appearances/goals/assists abaixo).
  // Nunca misturado com kind na filtragem por equipe (§9-§12): "Brasil"
  // aparece no mesmo dropdown que "Coritiba"/"Dortmund", mas nunca conta
  // como clube nos agregados de CLUBES nem vice-versa.
  kind String @default("club")

  clubName    String // nome do clube OU da seleção (kind decide qual)
  clubLogoUrl String?
  startYear   Int
  // "brasileiro" | "europeu" — por stint (não por carreira inteira, ao
  // contrário de Squad.seasonCalendar): a mesma carreira passa por clubes
  // com convenções de calendário diferentes (ex: Coritiba "2019" vs.
  // Dortmund "22/23"), então cada passagem guarda a sua própria.
  calendar String @default("brasileiro")

  // Usados por stints kind="club" — preenchidos à mão, exatamente como na
  // etapa 4. Stints kind="nationalTeam" deixam esses três zerados/sem uso:
  // o total anual da seleção (§3/§4) é sempre a soma de
  // CareerStintCompetitionStats (mesmo princípio de "nunca digitar um
  // total" já usado em Season.wins/PlayerCompetitionStats), calculada sob
  // demanda em lib/career.ts, nunca escrita aqui.
  appearances Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  summary     String? // resumo desta temporada da carreira (§7/§8) — independente de outras

  // Posição compartilhada na mesma sequência numérica de
  // PlayerCareer.transfers, pra intercalar stints e transferências na
  // linha do tempo em ordem cronológica real sem ambiguidade de "mesmo
  // ano" (ver career.service.ts).
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles           CareerTitle[]
  competitionStats CareerStintCompetitionStats[]

  @@index([careerId])
  @@index([seasonId])
}

// Estatísticas de UM ano de seleção (CareerStint kind="nationalTeam") NUMA
// competição específica (§3: Copa do Mundo, Eliminatórias, Amistosos...) —
// mesmo desenho de PlayerCompetitionStats (§ etapa 3), só que pendurado em
// CareerStint em vez de SquadPlayer. Nunca usado por stints kind="club",
// que continuam com os campos flat em CareerStint (§4 só pede total
// automático pra seleção, não muda o que já existe pra clube).
model CareerStintCompetitionStats {
  id            String      @id @default(cuid())
  stintId       String
  stint         CareerStint @relation(fields: [stintId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  appearances Int @default(0)
  goals       Int @default(0)
  assists     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stintId, competitionId])
  @@index([stintId])
  @@index([competitionId])
}

// Título conquistado NUMA passagem específica da carreira (§10) —
// reaproveita o mesmo Competition (com troféu) já usado pelos títulos de
// clube (SeasonTitle), pra não recadastrar a mesma competição duas vezes.
model CareerTitle {
  id            String      @id @default(cuid())
  stintId       String
  stint         CareerStint @relation(fields: [stintId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([stintId, competitionId])
  @@index([stintId])
}

// Um evento de transferência NA LINHA DO TEMPO da carreira (§2/§3) — "Clube
// A → Clube B, €valor" entre duas passagens. Dado textual (mesmo padrão do
// Transfer de clube já existente), sem vínculo obrigatório com um
// CareerStint específico: fromClubName/toClubName só precisam bater
// visualmente com os stints adjacentes, não são uma FK pra eles.
// Etapa 7 (§22/§23): quando uma transferência de clube (Transfer, acima) é
// feita para um jogador que já tem PlayerCareer vinculada ao mesmo
// CachedPlayer, uma CareerTransfer é criada automaticamente aqui —
// "utilizar a mesma entidade... evitar cadastrar a mesma transferência
// duas vezes" na prática, sem fundir os dois modelos (que têm escopos
// diferentes: Transfer pertence a UMA Season de UM clube, CareerTransfer
// pertence à carreira inteira). `sourceTransferId` é só uma referência —
// cópia feita uma vez na criação, nunca sincronizada depois (mesmo
// princípio de CareerStint.seasonId): editar/remover o Transfer do lado
// do clube não toca nessa linha, e apagar o Transfer de origem só
// desvincula (onDelete padrão do Prisma pra relação opcional), nunca
// apaga histórico de carreira. CareerTransfer continua podendo ser
// criada manualmente também (sourceTransferId null), como já era.
model CareerTransfer {
  id           String       @id @default(cuid())
  careerId     String
  career       PlayerCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)
  fromClubName String?
  toClubName   String
  value        Float?
  year         Int
  // Mesma sequência numérica de CareerStint.order — ver comentário lá.
  order        Int          @default(0)
  createdAt    DateTime     @default(now())

  sourceTransferId String?   @unique
  sourceTransfer   Transfer? @relation(fields: [sourceTransferId], references: [id])

  @@index([careerId])
}
